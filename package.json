{
  "name": "kaizer-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/copy-fonts.mjs && node tools/check-contrast.mjs && node tools/check-hardcoded.mjs && node tools/check-fonts.mjs && node tools/check-art.mjs && node tools/validate-constelaciones.ts",
    "build": "tsc --noEmit && vite build && node tools/build-report.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:fonts": "node tools/check-fonts.mjs",
    "check:art": "node tools/check-art.mjs",
    "check:hardcoded": "node tools/check-hardcoded.mjs",
    "report": "node tools/build-report.mjs",
    "reskin:test": "node tools/reskin-test.mjs",
    "icons": "node tools/make-icons.mjs",
    "validate": "node tools/validate-constelaciones.ts"
  },
  "devDependencies": {
    "@fontsource/patrick-hand": "^5.3.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tabler/icons": "^3.52.0"
  }
}
